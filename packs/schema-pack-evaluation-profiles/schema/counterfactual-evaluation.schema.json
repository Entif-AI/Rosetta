{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entif.ai/packs/schema-pack-evaluation-profiles/schema/counterfactual-evaluation.schema.json",
  "title": "Counterfactual Mechanism Evaluation Profile v1",
  "description": "Public Profile over Core Evaluation. Records a historical evidence frontier and no-live-effect comparison posture; does not enforce isolation or grant production authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluationId",
    "summary",
    "verdict",
    "profile",
    "historical",
    "candidate",
    "replay",
    "comparison",
    "disposition",
    "validityScope",
    "evidenceRefs",
    "counterEvidenceRefs",
    "receiptRefs",
    "provenanceRefs",
    "supersedesRefs",
    "laterEvaluationRefs"
  ],
  "properties": {
    "evaluationId": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "deny",
        "fail",
        "partial",
        "pass",
        "unknown"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "counterfactual.evaluation.v1"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectRefs",
        "decisionRef",
        "evidenceCutoff",
        "context"
      ],
      "properties": {
        "subjectRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "decisionRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceCutoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frontierRef",
            "availableAt",
            "inputRefs",
            "excludedLaterEvidenceRefs"
          ],
          "properties": {
            "frontierRef": {
              "type": "string",
              "minLength": 1
            },
            "availableAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
            },
            "inputRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "excludedLaterEvidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorityRefs",
            "policyRefs",
            "modelRefs",
            "runtimeRefs",
            "profileRefs",
            "budgetRefs"
          ],
          "properties": {
            "authorityRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "policyRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "modelRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "runtimeRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "profileRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "budgetRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanismRef",
        "version",
        "class"
      ],
      "properties": {
        "mechanismRef": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "runRefs",
        "mode",
        "liveEffects"
      ],
      "properties": {
        "state": {
          "enum": [
            "replayable",
            "partially-replayable",
            "non-replayable",
            "unknown"
          ]
        },
        "runRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mode": {
          "enum": [
            "no-live-effect",
            "sandbox"
          ]
        },
        "liveEffects": {
          "const": "none"
        },
        "sandboxRef": {
          "type": "string",
          "minLength": 1
        },
        "effectAttempt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestRef",
            "disposition",
            "receiptRef"
          ],
          "properties": {
            "requestRef": {
              "type": "string",
              "minLength": 1
            },
            "disposition": {
              "const": "rejected"
            },
            "receiptRef": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "sandbox"
              }
            }
          },
          "then": {
            "required": [
              "sandboxRef"
            ]
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteriaRef",
        "comparatorRefs",
        "verifierRefs",
        "qualityObservationRefs",
        "exceptionObservationRefs",
        "latencyObservationRefs",
        "computeObservationRefs",
        "tokenObservationRefs",
        "costObservationRefs",
        "maintenanceObservationRefs",
        "revalidationObservationRefs"
      ],
      "properties": {
        "criteriaRef": {
          "type": "string",
          "minLength": 1
        },
        "comparatorRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verifierRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "qualityObservationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exceptionObservationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "latencyObservationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "computeObservationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tokenObservationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "costObservationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maintenanceObservationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revalidationObservationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "disposition": {
      "enum": [
        "better",
        "equivalent-within-declared-criteria",
        "worse",
        "inconclusive",
        "invalid",
        "non-replayable",
        "unknown"
      ]
    },
    "validityScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeRef",
        "description"
      ],
      "properties": {
        "scopeRef": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counterEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "receiptRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "provenanceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "supersedesRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "laterEvaluationRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "enum": [
              "better",
              "equivalent-within-declared-criteria",
              "worse"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "comparison": {
            "properties": {
              "comparatorRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "verifierRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "qualityObservationRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "replay": {
            "properties": {
              "state": {
                "enum": [
                  "replayable",
                  "partially-replayable"
                ]
              },
              "runRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "non-replayable"
          }
        }
      },
      "then": {
        "properties": {
          "replay": {
            "properties": {
              "state": {
                "const": "non-replayable"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "replay": {
            "required": [
              "effectAttempt"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "invalid"
          }
        }
      }
    }
  ]
}
