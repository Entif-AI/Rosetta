{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entif.ai/packs/schema-pack-evaluation-profiles/schema/salience-evaluation.schema.json",
  "title": "Salience Evaluation Profile v1",
  "description": "A Profile over rosetta.evaluation. It represents distinct impact, exigency, and novelty assessments; it does not establish truth, authorization, activation, or execution policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment", "assessedAt", "evaluationId", "profile", "provenanceRefs", "receiptRefs", "scope", "summary", "validTime", "verdict"],
  "properties": {
    "evaluationId": { "type": "string" }, "summary": { "type": "string" }, "verdict": { "type": "string" }, "assessedAt": { "type": "string", "format": "date-time" },
    "profile": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "const": "salience.evaluation.v1" }, "version": { "const": "1.0.0" } } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["scale", "subjectRefs"], "properties": { "scale": { "enum": ["event", "cluster", "pattern", "trend", "system"] }, "subjectRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "validTime": { "type": "object", "minProperties": 1, "properties": { "validAt": { "type": "string" }, "validFrom": { "type": "string" }, "validTo": { "type": "string" } }, "additionalProperties": false },
    "receiptRefs": { "type": "array", "items": { "type": "string" } }, "provenanceRefs": { "type": "array", "items": { "type": "string" } }, "supersedesRefs": { "type": "array", "items": { "type": "string" } },
    "assessment": { "type": "object", "additionalProperties": false, "required": ["impact", "exigency", "novelty"], "properties": { "impact": { "$ref": "#/$defs/assessment" }, "exigency": { "$ref": "#/$defs/assessment" }, "novelty": { "$ref": "#/$defs/noveltyAssessment" } } }
  },
  "$defs": {
    "refs": { "type": "array", "items": { "type": "string" } },
    "value": { "type": "object", "additionalProperties": false, "required": ["representation", "schemaRef"], "properties": { "representation": { "type": "string" }, "schemaRef": { "type": "string" }, "allowedLevels": { "$ref": "#/$defs/refs" }, "level": { "type": "string" }, "value": {} } },
    "assessment": { "type": "object", "additionalProperties": false, "required": ["evidenceRefs", "provenanceRefs", "status", "uncertainty"], "properties": { "status": { "enum": ["observed", "estimated", "unknown", "unavailable"] }, "value": { "$ref": "#/$defs/value" }, "uncertainty": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string" } } }, "evidenceRefs": { "$ref": "#/$defs/refs" }, "provenanceRefs": { "$ref": "#/$defs/refs" }, "baselineRefs": { "$ref": "#/$defs/refs" }, "phenomenonRefs": { "$ref": "#/$defs/refs" } }, "allOf": [{ "if": { "properties": { "status": { "enum": ["unknown", "unavailable"] } } }, "then": { "not": { "required": ["value"] } }, "else": { "required": ["value"] } }] },
    "noveltyAssessment": { "allOf": [{ "$ref": "#/$defs/assessment" }, { "required": ["baselineRefs", "phenomenonRefs"], "properties": { "baselineRefs": { "$ref": "#/$defs/refs" }, "phenomenonRefs": { "$ref": "#/$defs/refs" } } }] }
  }
}
