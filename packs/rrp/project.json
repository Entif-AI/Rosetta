{
  "name": "packs-rrp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "packs/rrp",
  "projectType": "library",
  "targets": {
    "conformance": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node tools/pack-conformance/validate-packs.mjs"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/packs/**/*.json",
        "{workspaceRoot}/packs/**/*.md",
        "{workspaceRoot}/packs/**/*.ttl",
        "{workspaceRoot}/tools/pack-conformance/**/*.mjs"
      ],
      "outputs": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "vitest run tools/pack-conformance/validate-packs.spec.mjs"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/tools/pack-conformance/**/*.mjs",
        "{workspaceRoot}/vitest.config.ts",
        {
          "externalDependencies": ["vitest"]
        }
      ],
      "outputs": ["{workspaceRoot}/tools/pack-conformance/coverage"]
    }
  },
  "tags": ["packs", "rrp"]
}
