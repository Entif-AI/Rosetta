{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rosetta:evidence.independence.v1",
  "title": "Bounded evidence independence assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "assessmentRef",
    "recordId",
    "supersedesRef",
    "observedAt",
    "methodRef",
    "scope",
    "subjects",
    "edges",
    "declarations",
    "frontier",
    "outcome",
    "explanationRefs",
    "correctionRefs",
    "revalidationRefs",
    "receiptRefs"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "evidence.independence.v1"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "assessmentRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "recordId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "supersedesRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "methodRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "pair"
            },
            "members": {
              "type": "array",
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "set"
            },
            "members": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "clusterRef",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "cluster"
            },
            "clusterRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "members": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 2
            }
          }
        }
      ]
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "record",
          "manifestation",
          "ancestry",
          "origin",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "record": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "version",
                  "cid"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "manifestation": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "version",
                  "cid"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "ancestry": {
            "enum": [
              "complete",
              "unknown"
            ]
          },
          "origin": {
            "enum": [
              "original",
              "rosetta",
              "derived",
              "unknown"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          }
        }
      },
      "maxItems": 256,
      "minItems": 2
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "descendant",
          "ancestor",
          "kind",
          "evidenceRefs"
        ],
        "properties": {
          "descendant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "ancestor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "derivation",
              "quotation",
              "translation",
              "summary",
              "syndication",
              "mirror",
              "dataset-use",
              "export",
              "re-ingest"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          }
        }
      },
      "maxItems": 1024,
      "minItems": 0
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "members",
          "kind",
          "evidenceRefs"
        ],
        "properties": {
          "members": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 2
          },
          "kind": {
            "enum": [
              "independent-origins",
              "independent-analyses"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          }
        }
      },
      "maxItems": 2048,
      "minItems": 0
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "coverage",
        "unresolvedRefs",
        "evidenceRefs"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "unresolvedRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "INDEPENDENT",
        "PARTIALLY_INDEPENDENT",
        "COMMON_SOURCE",
        "DERIVED_COPY",
        "SYNDICATED",
        "SELF_REFERENTIAL_LINEAGE",
        "INDEPENDENCE_UNKNOWN"
      ]
    },
    "explanationRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "correctionRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "revalidationRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "receiptRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "minItems": 1
    }
  }
}
