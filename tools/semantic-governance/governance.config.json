{
  "schemaVersion": 1,
  "projectName": "rosetta-governance",
  "branchPolicy": "existing-authorized",
  "authoritySources": [
    "docs/RFCs/Rosetta v3.0.0 Core Spine Specification.md",
    "docs/governance/genesis/SEMANTIC_ALIGNMENT.md",
    "docs/governance/PUBLIC_COMMONS_AND_PRIVATE_OPERATION_BOUNDARY.md",
    "docs/governance/AUTHORITY_CLOSURE_AND_REQUIREMENTS_TRACEABILITY.md",
    "docs/spec/PROMOTION_TRANSITION_CONTRACT.md",
    "specs/architecture.md",
    "specs/principles.md"
  ],
  "projectionPath": ".specops/authority.json",
  "checks": {
    "authority": {
      "command": "node tools/semantic-governance/check-authority-closure.mjs",
      "owner": "docs/governance/AUTHORITY_CLOSURE_AND_REQUIREMENTS_TRACEABILITY.md",
      "inputs": [
        "{workspaceRoot}/packages/nx-governance/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/*"
      ]
    },
    "semantic": {
      "command": "node tools/semantic-governance/check-genesis-semantics.mjs",
      "owner": "docs/governance/genesis/SEMANTIC_ALIGNMENT.md",
      "inputs": [
        "{workspaceRoot}/packages/nx-governance/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/docs/**/*",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/apps/*/README.md",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/tools/semantic-governance/**/*"
      ]
    },
    "core-descent": {
      "command": "node tools/semantic-governance/core-descent-audit.mjs",
      "owner": "packages/rosetta-schemas/src/lib/core-descent.ts",
      "inputs": [
        "{workspaceRoot}/packages/nx-governance/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/docs/**/*",
        "{workspaceRoot}/packs/**/*",
        "{workspaceRoot}/tools/semantic-governance/**/*"
      ]
    },
    "docid": {
      "command": "node tools/docid-registry/registry.mjs",
      "owner": "docs/governance/ROSETTA_DOCID_REGISTRY.md",
      "inputs": [
        "{workspaceRoot}/packages/nx-governance/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/docs/RFCs/Rosetta v3.0.0 Core Spine Specification.md",
        "{workspaceRoot}/docs/governance/ROSETTA_DOCID_REGISTRY.json",
        "{workspaceRoot}/tools/docid-registry/**/*"
      ]
    },
    "packs": {
      "command": "node tools/pack-conformance/validate-packs.mjs",
      "owner": "packs/_schemas/pack-manifest.schema.json",
      "inputs": [
        "{workspaceRoot}/packages/nx-governance/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/packs/**/*",
        "{workspaceRoot}/tools/pack-conformance/**/*"
      ]
    },
    "profile": {
      "command": "node tools/semantic-governance/profile-admission.mjs",
      "owner": "docs/spec/PROMOTION_TRANSITION_CONTRACT.md",
      "inputs": [
        "{workspaceRoot}/packages/nx-governance/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/packs/**/*",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/spec-surfaces/**/*",
        "{workspaceRoot}/tools/semantic-governance/**/*",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/**/package.json",
        "{workspaceRoot}/tsconfig*.json"
      ]
    },
    "implementation": {
      "command": "pnpm exec nx affected -t lint,typecheck,test,build --base=origin/main --exclude=rosetta-governance,@entif-ai/source --parallel=3",
      "owner": "nx.json",
      "inputs": [
        "{workspaceRoot}/packages/nx-governance/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/*"
      ],
      "coordinator": true,
      "stage": "merge"
    },
    "catalog": {
      "command": "node tools/spec-catalog/catalog.mjs",
      "owner": "tools/spec-catalog/catalog.schema.json",
      "inputs": [
        "{workspaceRoot}/tools/spec-catalog/**/*",
        "{workspaceRoot}/tools/docid-registry/**/*",
        "{workspaceRoot}/tools/semantic-governance/**/*",
        "{workspaceRoot}/packs/**/*",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/docs/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/.prettierrc",
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/plans/**/*"
      ]
    },
    "release-plan": {
      "command": "pnpm exec nx release plan:check --base=origin/main",
      "owner": "nx.json",
      "inputs": [
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/.nx/version-plans/**/*",
        "{workspaceRoot}/packages/nx-governance/**/*",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "stage": "merge",
      "coordinator": true
    },
    "distribution": {
      "command": "pnpm exec nx run dev-bundle:e2e",
      "owner": "packages/nx-governance/spec-kit/compatibility.json",
      "inputs": [
        "{workspaceRoot}/packages/nx-governance/**/*",
        "{workspaceRoot}/tools/dev-bundle/**/*",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "stage": "merge",
      "coordinator": true
    },
    "desired-state": {
      "command": "node packages/nx-governance/specops/check.mjs",
      "owner": "specs/architecture.md",
      "inputs": [
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/plans/**/*",
        "{workspaceRoot}/packages/nx-governance/specops/**/*",
        "{workspaceRoot}/packages/nx-governance/src/**/*",
        "{workspaceRoot}/tools/specops/evidence/**/*",
        "{workspaceRoot}/tools/specops/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/tools/semantic-governance/governance.config.json"
      ]
    },
    "plan-history": {
      "command": "node packages/nx-governance/specops/check.mjs --base origin/main",
      "owner": "specs/architecture.md",
      "inputs": [
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/plans/**/*",
        "{workspaceRoot}/packages/nx-governance/specops/**/*",
        "{workspaceRoot}/packages/nx-governance/src/**/*",
        "{workspaceRoot}/tools/specops/evidence/**/*",
        "{workspaceRoot}/tools/specops/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/tools/semantic-governance/governance.config.json"
      ],
      "stage": "merge",
      "coordinator": true
    },
    "specops-tests": {
      "command": "node --test packages/nx-governance/specops/*.spec.mjs",
      "owner": "specs/architecture.md",
      "inputs": [
        "{workspaceRoot}/specs/**/*",
        "{workspaceRoot}/plans/**/*",
        "{workspaceRoot}/packages/nx-governance/specops/**/*",
        "{workspaceRoot}/packages/nx-governance/src/**/*",
        "{workspaceRoot}/tools/specops/evidence/**/*",
        "{workspaceRoot}/tools/specops/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/tools/semantic-governance/governance.config.json"
      ]
    }
  },
  "catalog": {
    "generator": "tools/spec-catalog/catalog.mjs",
    "outputs": [
      "docs/governance/ROSETTA_SPEC_CATALOG.json",
      "docs/governance/ROSETTA_SPEC_CATALOG.md",
      "docs/governance/ROSETTA_PACK_MAP.csv",
      "docs/governance/ROSETTA_SUBSTRATE_CATALOG.json"
    ]
  },
  "convergence": {
    "artifactPath": "tools/specops/evidence/substrate.convergence.json",
    "sourcePaths": [
      "packages/nx-governance/specops/check.mjs",
      "packages/nx-governance/specops/cli.mjs",
      "packages/nx-governance/specops/configuration.mjs",
      "packages/nx-governance/specops/context.mjs",
      "packages/nx-governance/specops/context.spec.mjs",
      "packages/nx-governance/specops/drift.mjs",
      "packages/nx-governance/specops/drift.spec.mjs",
      "packages/nx-governance/specops/entrypoint.mjs",
      "packages/nx-governance/specops/install.mjs",
      "packages/nx-governance/specops/install.spec.mjs",
      "packages/nx-governance/specops/plans.mjs",
      "packages/nx-governance/specops/plans.spec.mjs",
      "packages/nx-governance/specops/source.mjs",
      "packages/nx-governance/src/baseline.spec.ts",
      "packages/nx-governance/src/convergence.spec.ts",
      "packages/nx-governance/src/installation.spec.ts",
      "packages/nx-governance/src/installation.ts",
      "packages/nx-governance/src/specops-migration.spec.ts",
      "specs/architecture.md",
      "specs/principles.md",
      "tools/dev-bundle/e2e.mjs"
    ]
  }
}
