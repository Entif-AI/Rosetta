{
  "name": "trace-graph",
  "projectType": "application",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["projection-adapters", "source-substrate", "rosetta-store"], "target": "build" }],
      "options": {
        "command": "node --test tools/trace-graph/*.spec.mjs"
      }
    },
    "prove-kinematics": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["projection-adapters", "source-substrate", "rosetta-store"], "target": "build" }],
      "cache": false,
      "options": {
        "command": "node tools/trace-graph/prove-kinematics-falkordb.mjs"
      }
    },
    "prove": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "projection-adapters",
            "source-substrate",
            "rosetta-store"
          ],
          "target": "build"
        }
      ],
      "cache": false,
      "options": {
        "command": "node tools/trace-graph/prove-falkordb.mjs"
      }
    },
    "prove-neo4j-reference": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "projection-adapters",
            "source-substrate"
          ],
          "target": "build"
        }
      ],
      "cache": false,
      "options": {
        "command": "node tools/trace-graph/prove.mjs"
      }
    }
  }
}
