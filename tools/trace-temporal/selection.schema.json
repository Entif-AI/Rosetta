{
  "type": "object",
  "properties": {
    "profile": {
      "const": "trace.graphiti-selection.v1"
    },
    "profileVersion": {
      "const": "1.0.0"
    },
    "sourceArtifactRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "normalizedProfile": {
      "const": "trace.normalization.v1"
    },
    "normalizedVersion": {
      "type": "string",
      "minLength": 1
    },
    "normalizedDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "recordId": {
            "type": "string",
            "minLength": 1
          },
          "effectiveAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "correctionAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "scopeRef": {
            "type": "string",
            "minLength": 1
          },
          "rightsRef": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "enum": [
              "unresolved",
              "distinct"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "content": {},
          "sourceEventAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "recordedAt": {
            "type": "string",
            "minLength": 1
          },
          "timeBasis": {
            "enum": [
              "fixture",
              "relative-redacted"
            ]
          },
          "sourceSequence": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "recordId",
          "effectiveAt",
          "correctionAt",
          "scopeRef",
          "rightsRef",
          "identity",
          "id",
          "content",
          "sourceEventAt",
          "observedAt",
          "recordedAt",
          "timeBasis",
          "sourceSequence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profile",
    "profileVersion",
    "sourceArtifactRef",
    "sourceDigest",
    "normalizedProfile",
    "normalizedVersion",
    "normalizedDigest",
    "episodes"
  ],
  "additionalProperties": false
}
