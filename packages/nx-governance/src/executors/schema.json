{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "configPath"
  ],
  "properties": {
    "configPath": {
      "type": "string"
    },
    "checkId": {
      "type": "string"
    },
    "checkIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reportName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  },
  "additionalProperties": false
}
