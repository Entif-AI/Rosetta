{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Convergence candidate evidence, not semantic authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "featureId",
    "runId",
    "inventory",
    "findings"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "featureId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "authorityRef",
          "verificationRefs"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "authorityRef": {
            "type": "object",
            "required": [
              "path",
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              },
              "start": {
                "type": "integer",
                "minimum": 1
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "verificationRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "start",
                "end"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "sourceRef",
          "gapType",
          "severity",
          "evidenceRefs",
          "authorityRef",
          "affectedSurface",
          "observationRefs",
          "remediationTaskRefs",
          "verificationRefs",
          "status",
          "exceptionRef"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "sourceRef": {
            "type": "object",
            "required": [
              "path",
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              },
              "start": {
                "type": "integer",
                "minimum": 1
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "gapType": {
            "enum": [
              "missing",
              "partial",
              "contradicts",
              "unrequested",
              "authority-missing"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "start",
                "end"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "authorityRef": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "path",
                  "start",
                  "end"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "affectedSurface": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "observationRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^baseline:[a-z0-9-]+:[a-z0-9-]+$"
            }
          },
          "remediationTaskRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verificationRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "start",
                "end"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "status": {
            "enum": [
              "open",
              "remediated",
              "accepted-exception"
            ]
          },
          "exceptionRef": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "path",
                  "start",
                  "end"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
