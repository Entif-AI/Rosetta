{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "projectName", "branchPolicy", "authoritySources", "checks", "projectionPath"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "branchPolicy": { "const": "existing-authorized" },
    "authoritySources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
    "projectionPath": { "$ref": "#/definitions/path" },
    "checks": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object", "required": ["command", "owner", "inputs"], "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "coordinator": { "type": "boolean" }
        }
      }
    },
    "catalog": {
      "type": "object", "required": ["generator", "outputs"], "additionalProperties": false,
      "properties": { "generator": { "$ref": "#/definitions/path" }, "outputs": { "type": "array", "items": { "$ref": "#/definitions/path" } } }
    }
  },
  "definitions": { "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$" } }
}
