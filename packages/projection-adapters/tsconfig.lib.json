{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../source-substrate/tsconfig.lib.json"
    },
    {
      "path": "../rosetta-receipts/tsconfig.lib.json"
    },
    {
      "path": "../rosetta-core/tsconfig.lib.json"
    },
    {
      "path": "../ingress-refinery/tsconfig.lib.json"
    },
    {
      "path": "../rosetta-canon/tsconfig.lib.json"
    }
  ]
}
