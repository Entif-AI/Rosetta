{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:rosetta:tenancy.boundary.v1",
  "title": "Proposed hard-isolation and current-rights reference Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId",
    "profile",
    "isolation",
    "scopeBindingRefs",
    "rights",
    "disclosure",
    "provenanceRefs",
    "receiptRefs",
    "auditRefs",
    "supersedesRefs"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "tenancy.boundary.v1"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainRef",
        "versionRef",
        "ownerRef",
        "authorityRef"
      ],
      "properties": {
        "domainRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "versionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "ownerRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "authorityRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        }
      }
    },
    "scopeBindingRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRef",
        "rightsRef",
        "decisionRef",
        "currentnessFrontierRef",
        "revocationFrontierRef"
      ],
      "properties": {
        "policyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "rightsRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "decisionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "currentnessFrontierRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "revocationFrontierRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "softSharingRef",
        "opaqueHandleRef"
      ],
      "properties": {
        "mode": {
          "const": "hide-existence"
        },
        "softSharingRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "opaqueHandleRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenanceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "receiptRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "auditRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "supersedesRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    }
  }
}
