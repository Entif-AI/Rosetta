{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:rosetta:governance.module.v1",
  "title": "Candidate governance module registry metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId",
    "profile",
    "moduleRef",
    "title",
    "ownerRef",
    "categoryRef",
    "versionRef",
    "revisionRef",
    "artifact",
    "disclosure",
    "opaqueBindingRef",
    "state",
    "supersedesRefs",
    "replacedByRefs",
    "dependencies",
    "triggers",
    "conformanceRefs",
    "provenanceRefs",
    "receiptRefs"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "governance.module.v1"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "moduleRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "ownerRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "categoryRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "versionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "revisionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "disclosure": {
      "enum": [
        "PUBLIC",
        "OPAQUE"
      ]
    },
    "opaqueBindingRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:opaque:[a-zA-Z0-9_-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "PROPOSED",
        "CURRENT",
        "SUPERSEDED",
        "RETIRED"
      ]
    },
    "supersedesRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "replacedByRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleRef",
          "recordRef"
        ],
        "properties": {
          "moduleRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "recordRef": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 0,
      "maxItems": 256
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topicRefs",
        "operationRefs",
        "eventRefs",
        "applicabilityRefs"
      ],
      "properties": {
        "topicRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "operationRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "eventRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "applicabilityRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      }
    },
    "conformanceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "provenanceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "receiptRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    }
  }
}
