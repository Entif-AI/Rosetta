{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:rosetta:compiled.context.block.v1",
  "title": "Compiled context block v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blockRef",
    "familyRef",
    "sourceBindings",
    "originalAuthorityClass",
    "authorityClass",
    "evidenceRefs",
    "receiptRefs",
    "originalConflictRefs",
    "conflictRefs",
    "representation",
    "placement",
    "estimates",
    "compression",
    "reasonCodes",
    "freshnessRef"
  ],
  "properties": {
    "blockRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "familyRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "sourceBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "lineageRef",
          "spanRefs",
          "provenanceRefs",
          "policyRef",
          "rightsRef"
        ],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "version",
              "cid"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cid": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "lineageRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "spanRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          },
          "provenanceRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "policyRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "rightsRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      }
    },
    "originalAuthorityClass": {
      "enum": [
        "evidence",
        "advisory",
        "constraint",
        "unknown"
      ]
    },
    "authorityClass": {
      "enum": [
        "evidence",
        "advisory",
        "constraint",
        "unknown"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "receiptRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "originalConflictRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "conflictRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "inlineContent",
        "contentRef"
      ],
      "properties": {
        "mode": {
          "enum": [
            "inline",
            "reference"
          ]
        },
        "inlineContent": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 262144
            },
            {
              "type": "null"
            }
          ]
        },
        "contentRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "placement": {
      "enum": [
        "stable-prefix",
        "dynamic-tail",
        "unclassified"
      ]
    },
    "estimates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "bytes",
        "methodRef"
      ],
      "properties": {
        "tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "methodRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        }
      }
    },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "profileRef",
        "preservationRefs",
        "lossRefs"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "none",
            "applied",
            "declined",
            "restored-uncompressed"
          ]
        },
        "profileRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "preservationRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "lossRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      }
    },
    "reasonCodes": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "freshnessRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
