{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:rosetta:projection.provenance.v1",
  "title": "Bounded projection support handles v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "recordId",
    "projectionRef",
    "revisionRef",
    "materializedViewRef",
    "kind",
    "plane",
    "projectionSha256",
    "doctrineRef",
    "policyRef",
    "policyVersion",
    "transformRef",
    "support",
    "replay",
    "identitySensitive",
    "observedAt",
    "predecessorRef",
    "effectAuthority"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "projection.provenance.v1"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "recordId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "projectionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "revisionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "materializedViewRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "vector-chunk",
        "temporal-edge",
        "salience-score",
        "tag-summary",
        "lexical-shadow"
      ]
    },
    "plane": {
      "enum": [
        "truth-support",
        "temporal-projection",
        "activation",
        "non-authoritative-recall"
      ]
    },
    "projectionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "doctrineRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "policyRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "transformRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "support": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceRecordCid",
          "sourceManifestationCid",
          "artifactCid",
          "lineageRef",
          "scopeRef",
          "policyRef",
          "rightsRef",
          "spans",
          "receiptRefs"
        ],
        "properties": {
          "sourceRecordCid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "sourceManifestationCid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "artifactCid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "lineageRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "scopeRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "policyRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "rightsRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "spans": {
            "type": "array",
            "minItems": 0,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observationCid",
                "span",
                "offsetUnit"
              ],
              "properties": {
                "observationCid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "span": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sourceRecordCid",
                    "sourceManifestationCid",
                    "startOffset",
                    "endOffset",
                    "textHash"
                  ],
                  "properties": {
                    "sourceRecordCid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "sourceManifestationCid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    "startOffset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endOffset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "textHash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                },
                "offsetUnit": {
                  "const": "utf16-code-unit"
                }
              }
            }
          },
          "receiptRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceClosureRefs",
        "operationalClosureRefs",
        "reasonRefs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rebuildable",
            "non-replayable"
          ]
        },
        "sourceClosureRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "operationalClosureRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "reasonRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      }
    },
    "identitySensitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "policyRef",
        "authorizationRef"
      ],
      "properties": {
        "classification": {
          "enum": [
            "ordinary",
            "sensitive",
            "unknown"
          ]
        },
        "policyRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorizationRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "predecessorRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectAuthority": {
      "const": "none"
    }
  }
}
