{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:rosetta:graph.view.v1",
  "title": "Bounded derived GraphView v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "materialization",
    "purpose",
    "jurisdiction",
    "construction",
    "sources",
    "nodes",
    "edges",
    "evictions",
    "interViewRelations"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "graph.view.v1"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "materialization": {
      "$ref": "urn:rosetta:materialized.view.v1"
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionFamilyRef",
        "questionRef"
      ],
      "properties": {
        "questionFamilyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "questionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        }
      }
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "plane",
        "scopeRefs",
        "ownerRefs"
      ],
      "properties": {
        "authority": {
          "const": "projection"
        },
        "plane": {
          "const": "derived"
        },
        "scopeRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "ownerRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "minItems": 1
        }
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "admissibleFamilyRefs",
        "replay",
        "recipeRef",
        "sourceClosureRefs",
        "nonReplayReasonRefs"
      ],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          }
        },
        "admissibleFamilyRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "replay": {
          "enum": [
            "rebuildable",
            "non-replayable"
          ]
        },
        "recipeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "sourceClosureRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        },
        "nonReplayReasonRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "lineageRef",
          "evidenceRefs",
          "supportRefs",
          "provenanceRefs"
        ],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "version",
              "cid"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cid": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "lineageRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "supportRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "provenanceRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "familyRef",
          "lineageRefs",
          "supportRefs",
          "origin"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "familyRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "lineageRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "supportRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "origin": {
            "enum": [
              "source-supported",
              "view-inferred"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "fromRef",
          "toRef",
          "relationRef",
          "lineageRefs",
          "supportRefs",
          "origin",
          "assertionScope"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "fromRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "toRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "relationRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "lineageRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "supportRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "origin": {
            "enum": [
              "source-supported",
              "view-inferred"
            ]
          },
          "assertionScope": {
            "const": "view-local"
          }
        }
      }
    },
    "evictions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectRef",
          "lineageRefs",
          "reasonRefs",
          "sourceDisposition"
        ],
        "properties": {
          "subjectRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "lineageRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "reasonRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "sourceDisposition": {
            "const": "preserved"
          }
        }
      }
    },
    "interViewRelations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "viewRef",
          "relationRef",
          "authority",
          "supportRefs"
        ],
        "properties": {
          "viewRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "relationRef": {
            "enum": [
              "prov:wasDerivedFrom",
              "urn:rosetta:graph-view:overlaps",
              "urn:rosetta:graph-view:meta-of"
            ]
          },
          "authority": {
            "const": "projection"
          },
          "supportRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
