{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:rosetta:decision.record.v1",
  "title": "Candidate decision record and effective-state evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId",
    "profile",
    "decisionRef",
    "versionRef",
    "locusRef",
    "controllerRef",
    "authorRef",
    "ratification",
    "scopeRefs",
    "state",
    "clauses",
    "source",
    "time",
    "relations",
    "provenanceRefs",
    "receiptRefs"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "decision.record.v1"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "decisionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "versionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "locusRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "controllerRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "authorRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "ratification": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ratifierRef",
            "authorityRef",
            "evidenceRefs"
          ],
          "properties": {
            "ratifierRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "authorityRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "evidenceRefs": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "scopeRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "state": {
      "enum": [
        "PROPOSED",
        "DRAFT",
        "ACCEPTED",
        "EFFECTIVE",
        "HISTORICAL",
        "REJECTED",
        "WITHDRAWN",
        "UNKNOWN"
      ]
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clauseRef",
          "propositionRef"
        ],
        "properties": {
          "clauseRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "propositionRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 0,
      "maxItems": 256
    },
    "source": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "lineageRef",
          "locatorRef"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "version",
              "cid"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cid": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "lineageRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "locatorRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectiveFrom",
        "effectiveUntil",
        "observedAt",
        "recordedAt"
      ],
      "properties": {
        "effectiveFrom": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "targetRecordRef",
          "clauseRefs",
          "evidenceRefs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "ADDS",
              "SUPERSEDES",
              "AMENDS",
              "NARROWS",
              "EXCEPTS",
              "TEMPORARILY_OVERRIDES",
              "CORRECTS",
              "RETRACTS",
              "PEER_CONFLICT"
            ]
          },
          "targetRecordRef": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "clauseRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 0,
      "maxItems": 256
    },
    "provenanceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "receiptRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    }
  }
}
