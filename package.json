{
  "name": "@entif-ai/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "api": "pnpm exec nx serve rosetta-api",
    "affected:build": "pnpm exec nx affected -t build --base=origin/main --exclude @entif-ai/source --parallel=3",
    "affected:lint": "pnpm exec nx affected -t lint --base=origin/main --parallel=3",
    "affected:test": "pnpm exec nx affected -t test --base=origin/main --exclude @entif-ai/source --parallel=3",
    "affected:typecheck": "pnpm exec nx affected -t typecheck --base=origin/main --exclude @entif-ai/source --parallel=3",
    "affected:verify": "pnpm run affected:lint && pnpm run affected:typecheck && pnpm run affected:test && pnpm run affected:build",
    "build": "pnpm run affected:build",
    "demo": "pnpm exec nx sync && pnpm exec nx build rosetta-cli && node apps/rosetta-cli/dist/main.js",
    "docs:intake": "pnpm exec nx run doc-intake:generate",
    "docs:intelligence": "pnpm exec nx run doc-intake:intelligence",
    "docs:intake:validate": "pnpm exec nx run doc-intake:validate-intelligence",
    "entif-site:dev": "pnpm exec nx run entif-site:dev",
    "graph": "pnpm exec nx graph",
    "lint": "pnpm run affected:lint",
    "lint:full": "pnpm exec nx run-many -t lint --all --parallel=3",
    "packs:conformance": "pnpm exec nx run packs-rrp:conformance",
    "sync": "NX_DAEMON=false pnpm exec nx sync",
    "test": "pnpm run affected:test",
    "test:full": "pnpm exec nx run-many -t test --all --exclude @entif-ai/source --parallel=3",
    "typecheck": "pnpm run affected:typecheck",
    "typecheck:full": "pnpm exec nx run-many -t typecheck --all --exclude @entif-ai/source --parallel=3",
    "verify": "pnpm run docs:registry:check && pnpm run docs:registry:test && pnpm run governance:authority && pnpm run governance:authority:test && pnpm run governance:semantic && pnpm run governance:semantic:test && pnpm run affected:verify",
    "verify:full": "pnpm run docs:registry:check && pnpm run docs:registry:test && pnpm run governance:authority && pnpm run governance:authority:test && pnpm run governance:semantic && pnpm run governance:semantic:test && pnpm run lint:full && pnpm run typecheck:full && pnpm run test:full && pnpm exec nx run-many -t build --all --exclude @entif-ai/source --parallel=3",
    "prepare": "husky",
    "governance:authority": "node tools/semantic-governance/check-authority-closure.mjs",
    "governance:authority:test": "node --test tools/semantic-governance/check-authority-closure.spec.mjs",
    "governance:semantic": "node tools/semantic-governance/check-genesis-semantics.mjs",
    "governance:semantic:test": "pnpm exec vitest run tools/semantic-governance/check-genesis-semantics.spec.mjs",
    "docs:registry:generate": "node tools/docid-registry/registry.mjs --write",
    "docs:registry:check": "node tools/docid-registry/registry.mjs",
    "docs:registry:test": "node --test tools/docid-registry/registry.test.mjs"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^8.57.0",
    "@nx/esbuild": "22.6.5",
    "@nx/eslint": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/node": "22.6.5",
    "@nx/react": "22.6.5",
    "@nx/vite": "22.6.5",
    "@nx/vitest": "22.6.5",
    "@nx/web": "22.6.5",
    "@react-router/dev": "7.12.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.21",
    "@types/node": "^20.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/ui": "4.1.4",
    "esbuild": "^0.19.2",
    "eslint": "~8.57.0",
    "eslint-plugin-astro": "~1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.6.5",
    "prettier": "^2.6.2",
    "prettier-plugin-astro": "0.10.0",
    "tslib": "^2.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.33.1",
    "vite": "7.3.2",
    "vitest": "4.1.4"
  },
  "dependencies": {
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "isbot": "^4.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.12.0"
  }
}
