---
import FullWidthPageLayout from './FullWidthPageLayout.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<FullWidthPageLayout title={title} description={description}>
  <slot name="head" slot="head" />
  <div class="about-surface" data-test-id="about-surface">
    <slot />
  </div>
</FullWidthPageLayout>
