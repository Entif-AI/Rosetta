---
import ScrollTop from '../components/ScrollTop.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { joinBasePath } from '../lib/content';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pageTitle = title.includes('Entif.AI') ? title : `${title} · Entif.AI`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const logoPath = joinBasePath(
  import.meta.env.BASE_URL,
  'brand/entif-logo.webp'
);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071d49" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={logoPath} type="image/webp" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(logoPath, Astro.site ?? Astro.url.origin)}
    />
    <title>{pageTitle}</title>
    <slot name="head" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-85BLT96B14"></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-85BLT96B14');
    </script>
  </head>

  <body>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <ScrollTop />
  </body>
</html>
