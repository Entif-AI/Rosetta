---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ClaimJourney from '../components/ClaimJourney.astro';
import ContentCard from '../components/ContentCard.astro';
import { getPublishedEntries, toSummary } from '../lib/site-data';
import { joinBasePath, toContentCard } from '../lib/content';
import { copy } from '../lib/copy';
const base = import.meta.env.BASE_URL;
const entries = (await getPublishedEntries())
  .filter((entry) => entry.data.kind === 'research')
  .slice(0, 3);
const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing home copy');
const { Content } = await render(home);
---

<BaseLayout title={copy.brandTagline} description={copy.heroDescription}>
  <section class="hero shell" data-test-id="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">{copy.heroEyebrow}</p><h1
        data-test-id="home-hero-heading"
      >
        {copy.heroTitle}
      </h1><p class="lede">{copy.heroDescription}</p><div class="hero-actions">
        <a class="button primary" href={joinBasePath(base, 'projects/rosetta/')}
          >{copy.explore}</a
        ><a class="button secondary" href="#claim-journey">{copy.trace}</a>
      </div>
    </div><ClaimJourney />
  </section>
  <section class="section shell" id="research">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{copy.researchEyebrow}</p><h2>
          {copy.researchTitle}
        </h2>
      </div><p>{copy.researchDescription}</p>
    </div><div class="card-grid">
      {
        entries.map((entry) => (
          <ContentCard card={toContentCard(toSummary(entry), base)} />
        ))
      }
    </div><a class="text-link" href={joinBasePath(base, 'research/')}
      >{copy.allResearch} <span aria-hidden="true">→</span></a
    >
  </section>
  <section class="principles-band">
    <div class="section shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{copy.principlesEyebrow}</p><h2
            data-test-id="home-philosophy-heading"
          >
            {copy.principlesTitle}
          </h2>
        </div><p>{copy.principlesDescription}</p>
      </div><div
        class="prose home-principles-body"
        data-test-id="home-philosophy-body"
      >
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>
