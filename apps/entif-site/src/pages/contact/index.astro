---
import { getEntry, render } from 'astro:content';
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
const entry = await getEntry('pages', 'contact');
if (!entry) throw new Error('Missing page copy');
const { Content } = await render(entry);
---

<ContentPageLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={entry.data.eyebrow}
  heading={entry.data.title}
  lede={entry.data.description}
>
  <div class="prose"><Content /></div>
</ContentPageLayout>
