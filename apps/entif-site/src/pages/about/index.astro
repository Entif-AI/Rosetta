---
import { getEntry, render } from 'astro:content';
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import '../../styles/about.css';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing page copy');
const { Content } = await render(entry);
---

<ContentPageLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={entry.data.eyebrow}
  heading={entry.data.title}
  lede={entry.data.description}
  pageClass="about-page"
>
  <div class="prose about-prose"><Content /></div>
</ContentPageLayout>
