---
import { getEntry } from 'astro:content';
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getPublishedEntries, toSummary } from '../../lib/site-data';
import { toContentCard, joinBasePath } from '../../lib/content';
import { copy } from '../../lib/copy';
const entry = await getEntry('pages', 'articles');
if (!entry) throw new Error('Missing page copy');
const base = import.meta.env.BASE_URL;
const entries = (await getPublishedEntries()).filter(
  (entry) =>
    ['essay', 'update'].includes(entry.data.kind) &&
    !entry.data.hideFromArticlesIndex
);
entries.sort((left, right) => {
  if (
    left.data.series?.id !== undefined &&
    left.data.series.id === right.data.series?.id
  ) {
    return left.data.series.order - right.data.series.order;
  }
  return 0;
});
---

<ContentPageLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={entry.data.eyebrow}
  heading={entry.data.title}
  lede={entry.data.description}
>
  {
    entries.length ? (
      <div class="card-grid">
        {entries.map((item, index) => (
          <ContentCard
            headingLevel={2}
            card={toContentCard(toSummary(item), base)}
            artworkIndex={index}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <>
          <p>{copy.emptyArticles}</p>
          <a class="text-link" href={joinBasePath(base, 'research/')}>
            {copy.allResearch}
          </a>
        </>
      </div>
    )
  }
</ContentPageLayout>
