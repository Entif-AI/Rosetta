---
import { copy, formatCopy } from '../../../lib/copy';
import ContentCard from '../../../components/ContentCard.astro';
import ContentPageLayout from '../../../layouts/ContentPageLayout.astro';
import {
  countTopics,
  getTaxonomyTerms,
  toContentCard,
} from '../../../lib/content';
import {
  getPublishedEntries,
  toSummary,
  type SiteEntry,
} from '../../../lib/site-data';

export async function getStaticPaths() {
  const entries = await getPublishedEntries();
  const summaries = entries.map(toSummary);

  return [...countTopics(summaries).keys()].map((tag) => ({
    params: { tag },
    props: { tag, entries },
  }));
}

interface RouteProps {
  tag: string;
  entries: readonly SiteEntry[];
}

const { tag, entries } = Astro.props as RouteProps;
const baseUrl = import.meta.env.BASE_URL;
const matching = entries
  .map(toSummary)
  .filter((item) => getTaxonomyTerms(item).includes(tag));
const lede = formatCopy(copy.tagCount, { count: matching.length });
---

<ContentPageLayout
  title={formatCopy(copy.tagTitle, { tag })}
  description={`Published Entif AI work connected to the ${tag} tag.`}
  eyebrow={copy.tags}
  heading={tag}
  lede={lede}
>
  <div class="card-grid" data-test-id="tag-page-grid">
    {
      matching.map((item) => (
        <ContentCard headingLevel={2} card={toContentCard(item, baseUrl)} />
      ))
    }
  </div>
</ContentPageLayout>
