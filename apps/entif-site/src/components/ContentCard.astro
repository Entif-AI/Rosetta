---
import { Image } from 'astro:assets';
import { copy } from '../lib/copy';
import type { ContentCardData } from '../lib/content';
import { getContentCardArtwork } from '../lib/content-card-art';

interface Props {
  card: ContentCardData;
  headingLevel?: 2 | 3;
  artworkIndex?: number;
  variant?: 'standard' | 'compact';
  linkTestId?: string;
}

const {
  card,
  headingLevel = 3,
  artworkIndex = 0,
  variant = 'standard',
  linkTestId,
} = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const encodedId = encodeURIComponent(card.id);
const testId = `content-card-${encodedId}`;
const linkId = linkTestId ? `${linkTestId}-${encodedId}` : `${testId}-link`;
const artwork = getContentCardArtwork(artworkIndex);
const actionLabel =
  card.kind === 'project'
    ? 'Explore project'
    : card.kind === 'research'
    ? 'Read research'
    : card.kind === 'protocol'
    ? 'View protocol'
    : 'Read article';
---

<article
  class:list={['content-card', `content-card--${variant}`]}
  data-test-id={testId}
  data-card-artwork={artwork.name}
>
  <div class="content-card-media" aria-hidden="true">
    <Image
      src={artwork.image}
      alt=""
      widths={[320, 640]}
      sizes={variant === 'compact'
        ? '(min-width: 48rem) 12rem, 100vw'
        : '(min-width: 64rem) 30vw, (min-width: 48rem) 46vw, 100vw'}
      format="webp"
      quality={78}
      loading="lazy"
      class="content-card-image"
      data-test-id={`${testId}-image`}
    />
  </div>
  <div class="content-card-copy">
    <div class="card-meta">
      <span class="eyebrow">{card.kind}</span>
      {card.projects.length > 0 && <span>{card.projects.join(' · ')}</span>}
    </div>
    <Heading data-test-id={`${testId}-heading`}>
      <a href={card.href} data-test-id={linkId}>{card.title}</a>
    </Heading>
    {
      card.published && card.kind !== 'project' && (
        <h3 class="lede" data-test-id={`${testId}-date`}>
          {card.published.toDateString()}
        </h3>
      )
    }
    <p class="content-card-description" data-test-id={`${testId}-description`}>
      {card.description}
    </p>
    {
      card.tags.length > 0 && (
        <ul
          class="tag-list"
          aria-label={copy.topics}
          data-test-id={`${testId}-tags`}
        >
          {card.tags.slice(0, 4).map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    <span
      class="content-card-action"
      aria-hidden="true"
      data-test-id={`${testId}-action`}
    >
      {actionLabel}<span>→</span>
    </span>
  </div>
</article>
