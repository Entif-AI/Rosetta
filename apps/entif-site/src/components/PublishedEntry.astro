---
import { copy } from '../lib/copy';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from './ContentCard.astro';
import {
  getTaxonomyTerms,
  joinBasePath,
  rankRelatedContent,
  toContentCard,
} from '../lib/content';
import { toSummary, type SiteEntry } from '../lib/site-data';

interface Props {
  entry: SiteEntry;
  allEntries: readonly SiteEntry[];
}

const { entry, allEntries } = Astro.props;
const { Content, headings } = await render(entry);
const summary = toSummary(entry);
const related = rankRelatedContent(summary, allEntries.map(toSummary));
const baseUrl = import.meta.env.BASE_URL;
const taxonomyTerms = getTaxonomyTerms(summary);
const publishedLabel = entry.data.published.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const isProject = entry.data.kind === 'project';
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  noindex={entry.data.noindex}
>
  <article
    class="article-shell shell"
    data-test-id="published-entry"
    data-content-id={entry.data.id}
  >
    <header class="article-header">
      <nav class="breadcrumbs" aria-label={copy.breadcrumb}>
        <a href={joinBasePath(baseUrl, '')}>{copy.brand}</a>
        <span aria-hidden="true">/</span>
        {
          isProject ? (
            <a href={joinBasePath(baseUrl, 'projects/')}>{copy.projects}</a>
          ) : (
            <>
              <a href={joinBasePath(baseUrl, 'tags/')}>{copy.tags}</a>
              <span aria-hidden="true">/</span>
              <a
                href={joinBasePath(baseUrl, `tags/${summary.routeTag}/`)}
                data-test-id="published-entry-route-tag"
              >
                {summary.routeTag}
              </a>
            </>
          )
        }
      </nav>
      <p class="eyebrow">{entry.data.kind} · {publishedLabel}</p>
      <h1 data-test-id="published-entry-heading">{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      {
        taxonomyTerms.length > 0 && (
          <ul class="tag-list article-tags" aria-label={copy.topics}>
            {taxonomyTerms.map((term) => (
              <li>
                <a href={joinBasePath(baseUrl, `tags/${term}/`)}>{term}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="article-grid">
      <div class="article-body prose" data-test-id="published-entry-body">
        <Content />
      </div>
      <aside
        class="article-aside"
        aria-label={copy.metadata}
        data-test-id="published-entry-metadata"
      >
        <p class="eyebrow">{copy.metadata}</p>
        <dl>
          <div>
            <dt>{copy.contentId}</dt>
            <dd data-test-id="published-entry-content-id">{entry.data.id}</dd>
          </div>
          <div><dt>{copy.status}</dt><dd>{entry.data.status}</dd></div>
          <div>
            <dt>{copy.authors}</dt><dd>{entry.data.authors.join(', ')}</dd>
          </div>
          {
            entry.data.report && (
              <div>
                <>
                  <dt>{copy.report}</dt>
                  <dd>{entry.data.report}</dd>
                </>
              </div>
            )
          }
          {
            entry.data.version && (
              <div>
                <>
                  <dt>{copy.version}</dt>
                  <dd>{entry.data.version}</dd>
                </>
              </div>
            )
          }
          {
            entry.data.review && (
              <div>
                <>
                  <dt>{copy.review}</dt>
                  <dd>{entry.data.review}</dd>
                </>
              </div>
            )
          }
          {
            entry.data.evidenceCutoff && (
              <div>
                <>
                  <dt>{copy.cutoff}</dt>
                  <dd>{entry.data.evidenceCutoff}</dd>
                </>
              </div>
            )
          }
        </dl>
        {
          entry.data.manuscript && (
            <a
              class="text-link"
              href={joinBasePath(baseUrl, entry.data.manuscript)}
              download
            >
              {copy.download}
            </a>
          )
        }
        {
          headings.length > 0 && (
            <nav aria-label={copy.contents}>
              <>
                <details class="contents-disclosure">
                  <summary class="eyebrow">{copy.contents}</summary>
                  <ol class="toc">
                    {headings
                      .filter((h) => h.depth === 2)
                      .map((h) => (
                        <li>
                          <a href={`#${h.slug}`}>{h.text}</a>
                        </li>
                      ))}
                  </ol>
                </details>
              </>
            </nav>
          )
        }
      </aside>
    </div>
  </article>

  {
    related.length > 0 && (
      <section
        class="section shell related-section"
        aria-labelledby="related-heading"
        data-test-id="related-content"
      >
        <div class="section-heading narrow">
          <div>
            <p class="eyebrow">{copy.relatedEyebrow}</p>
            <h2 id="related-heading">{copy.relatedTitle}</h2>
          </div>
        </div>
        <div class="card-grid">
          {related.map((item) => (
            <ContentCard card={toContentCard(item, baseUrl)} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
